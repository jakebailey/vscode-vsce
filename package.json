{
	"name": "@vscode/vsce",
	"version": "0.0.0",
	"description": "VS Code Extensions Manager",
	"repository": {
		"type": "git",
		"url": "https://github.com/Microsoft/vsce"
	},
	"type": "module",
	"homepage": "https://code.visualstudio.com",
	"bugs": "https://github.com/Microsoft/vsce/issues",
	"keywords": [
		"vscode",
		"vsce",
		"extension"
	],
	"publishConfig": {
		"access": "public"
	},
	"contributors": [
		"Microsoft Corporation"
	],
	"author": "Microsoft Corporation",
	"license": "MIT",
	"main": "out/api.js",
	"typings": "dist/vsce.d.ts",
	"bin": {
		"vsce": "vsce"
	},
	"scripts": {
		"compile": "tsc",
		"api": "api-extractor run --local --verbose",
		"build": "npm run compile && npm run api",
		"watch:build": "npm run compile -- --watch",
		"test": "mocha",
		"watch:test": "npm run test -- --watch"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@azure/identity": "^4.13.1",
		"@napi-rs/keyring": "^1.3.0",
		"@secretlint/node": "^13.0.2",
		"@secretlint/secretlint-formatter-sarif": "^13.0.2",
		"@secretlint/secretlint-rule-no-dotenv": "^13.0.2",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
		"@vscode/vsce-sign": "^2.0.9",
		"azure-devops-node-api": "^12.5.0",
		"chalk": "^5.6.2",
		"cockatiel": "^4.0.0",
		"commander": "^15.0.0",
		"form-data": "^4.0.6",
		"glob": "^13.0.6",
		"hosted-git-info": "^4.0.2",
		"jsonc-parser": "^3.3.1",
		"leven": "^4.1.0",
		"marked": "^18.0.5",
		"mime": "^4.1.0",
		"minimatch": "^10.2.5",
		"parse-semver": "^1.1.1",
		"parse5": "^8.0.1",
		"read": "^6.0.0",
		"semver": "^7.8.5",
		"typed-rest-client": "^1.8.4",
		"url-join": "^5.0.0",
		"xml2js": "^0.6.2",
		"yauzl": "^3.4.0",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "^7.58.9",
		"@types/hosted-git-info": "^3.0.5",
		"@types/mime": "^4.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.0",
		"@types/semver": "^7.7.1",
		"@types/tmp": "^0.2.6",
		"@types/url-join": "^5.0.0",
		"@types/xml2js": "^0.4.14",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"mocha": "^11.7.6",
		"tmp": "^0.2.7",
		"tsx": "^4.22.4",
		"typescript": "~5.9.0"
	},
	"mocha": {
		"node-option": [
			"import=tsx"
		],
		"watch-files": "src/**",
		"spec": "src/test/**/*.ts"
	},
	"overrides": {
		"serialize-javascript": "7.x",
		"diff": "^9.0.0"
	}
}
